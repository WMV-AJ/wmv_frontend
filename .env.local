# Dubai Event Discovery Platform — production env (committed; consumed by VPS deploy)
# For local dev, override individual values via .env.development.local (gitignored).

# WMV backend — same-origin; nginx reverse-proxies /api/auth/* and /api/analytics/* to the backend
NEXT_PUBLIC_BACKEND_URL=https://wheresmyvibe.com

# Google Analytics 4 — leave empty to disable GA4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

NEXT_PUBLIC_APP_URL=https://wheresmyvibe.com
NODE_ENV=production
